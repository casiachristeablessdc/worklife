+  static Future<void> _showActivityDialog(
+    BuildContext context,
+    String userId, {
+    DocumentSnapshot<Map<String, dynamic>>? existingActivity,
+  }) async {
+    final data = existingActivity?.data();
+
+    final titleController = TextEditingController(
+      text: data?['title']?.toString() ?? '',
+    );
+
+    final notesController = TextEditingController(
+      text: data?['notes']?.toString() ?? '',
+    );
+
+    final durationController = TextEditingController(
+      text: data?['durationMinutes']?.toString() ?? '',
+    );
+
+    String category = data?['category']?.toString() ?? 'Personal';
+
+    final categories = [
+      'Work',
+      'Health',
+      'Personal',
+      'Leisure',
+      'Learning',
+      'Other',
+    ];
+
+    final isEditing = existingActivity != null;
+
+    await showDialog<void>(
+      context: context,
+      builder: (dialogContext) {
+        return StatefulBuilder(
+          builder: (context, setDialogState) {
+            return AlertDialog(
+              backgroundColor: AppColors.ivory,
+              title: Text(
+                isEditing ? 'Edit activity' : 'Add activity',
+                style: GoogleFonts.fraunces(
+                  fontSize: 22,
+                  fontWeight: FontWeight.w600,
+                  color: AppColors.ink,
+                ),
+              ),
+              content: SingleChildScrollView(
+                child: Column(
+                  mainAxisSize: MainAxisSize.min,
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    TextField(
+                      controller: titleController,
+                      decoration: const InputDecoration(
+                        labelText: 'Activity',
+                        hintText: 'What do you want to do?',
+                      ),
+                    ),
+                    const SizedBox(height: 14),
+                    DropdownButtonFormField<String>(
+                      initialValue: categories.contains(category)
+                          ? category
+                          : 'Personal',
+                      decoration: const InputDecoration(
+                        labelText: 'Category',
+                      ),
+                      items: categories
+                          .map(
+                            (item) => DropdownMenuItem(
+                              value: item,
+                              child: Text(item),
+                            ),
+                          )
+                          .toList(),
+                      onChanged: (value) {
+                        if (value == null) return;
+
+                        setDialogState(() {
+                          category = value;
+                        });
+                      },
+                    ),
+                    const SizedBox(height: 14),
+                    TextField(
+                      controller: durationController,
+                      keyboardType: TextInputType.number,
+                      decoration: const InputDecoration(
+                        labelText: 'Duration',
+                        hintText: 'Minutes',
+                      ),
+                    ),
+                    const SizedBox(height: 14),
+                    TextField(
+                      controller: notesController,
+                      maxLines: 3,
+                      decoration: const InputDecoration(
+                        labelText: 'Notes',
+                        hintText: 'Optional',
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+              actions: [
+                TextButton(
+                  onPressed: () {
+                    Navigator.pop(dialogContext);
+                  },
+                  child: const Text('Cancel'),
+                ),
+                FilledButton(
+                  onPressed: () async {
+                    final title = titleController.text.trim();
+
+                    if (title.isEmpty) {
+                      return;
+                    }
+
+                    final durationText = durationController.text.trim();
+                    final duration = durationText.isEmpty
+                        ? 0
+                        : int.tryParse(durationText);
+
+                    if (duration == null || duration < 0) {
+                      ScaffoldMessenger.of(context).showSnackBar(
+                        const SnackBar(
+                          content: Text('Please enter a valid duration in minutes.'),
+                        ),
+                      );
+                      return;
+                    }
+                    final service = FirestoreService();
+
+                    if (isEditing) {
+                      final activityData = existingActivity!.data()!;
+
+                      final dateString =
+                          activityData['date']?.toString();
+
+                      final date = dateString != null
+                          ? _parseDateKey(dateString)
+                          : DateTime.now();
+
+                      await service.updateActivity(
+                        userId: userId,
+                        activityId: existingActivity.id,
+                        title: title,
+                        category: category,
+                        date: date,
+                        notes: notesController.text.trim(),
+                        durationMinutes: duration,
+                        completed:
+                            activityData['completed'] == true,
+                      );
+                    } else {
+                      await service.createActivity(
+                        userId: userId,
+                        title: title,
+                        category: category,
+                        date: DateTime.now(),
+                        notes: notesController.text.trim(),
+                        durationMinutes: duration,
+                      );
+                    }
+
+                    if (dialogContext.mounted) {
+                      Navigator.pop(dialogContext);
+                    }
+                  },
+                  child: Text(
+                    isEditing ? 'Save changes' : 'Add activity',
+                  ),
+                ),
+              ],
+            );
+          },
+        );
+      },
+    );
+
+    titleController.dispose();
+    notesController.dispose();
+    durationController.dispose();
+  }
+
+  static DateTime _parseDateKey(String value) {
+    final parts = value.split('-');
+
+    if (parts.length != 3) {
+      return DateTime.now();
+    }
+
+    final year = int.tryParse(parts[0]);
+    final month = int.tryParse(parts[1]);
+    final day = int.tryParse(parts[2]);
+
+    if (year == null || month == null || day == null) {
+      return DateTime.now();
+    }
+
+    return DateTime(year, month, day);
+  }
+
+  static Future<void> _deleteActivity(
+    BuildContext context,
+    String userId,
+    String activityId,
+  ) async {
+    final shouldDelete = await showDialog<bool>(
+      context: context,
+      builder: (dialogContext) {
+        return AlertDialog(
+          backgroundColor: AppColors.ivory,
+          title: Text(
+            'Delete activity?',
+            style: GoogleFonts.fraunces(
+              fontSize: 21,
+              fontWeight: FontWeight.w600,
+              color: AppColors.ink,
+            ),
+          ),
+          content: Text(
+            'This activity will be permanently removed.',
+            style: GoogleFonts.inter(
+              fontSize: 13,
+              color: AppColors.sub,
+            ),
+          ),
+          actions: [
+            TextButton(
+              onPressed: () {
+                Navigator.pop(dialogContext, false);
+              },
+              child: const Text('Cancel'),
+            ),
+            FilledButton(
+              onPressed: () {
+                Navigator.pop(dialogContext, true);
+              },
+              child: const Text('Delete'),
+            ),
+          ],
+        );
+      },
+    );
+
+    if (shouldDelete != true) {
+      return;
+    }
+
+    await FirestoreService().deleteActivity(
+      userId: userId,
+      activityId: activityId,
+    );
+  }
 }
 
